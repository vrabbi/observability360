          "query": "OTELLogs\n| where $__timeFilter(Timestamp)\n| extend ServiceName = tostring(parse_json(ResourceAttributes)[\"service.name\"])\n| where ServiceName != \"\"\n| where tolower(SeverityText) in (\"error\", \"critical\")\n| make-series ErrorCount=count() on Timestamp from bin($__timeFrom, ${bin_size}) to bin(now(), ${bin_size}) - totimespan(${bin_size}) step ${bin_size} by ServiceName\n| extend (Baseline, Seasonal, Trend, Residual) = series_decompose(ErrorCount)\n| extend (r_min, r_min_idx, r_max, r_max_idx, r_avg, r_stdev, r_var) = series_stats(Residual)\n| extend (t_min, t_min_idx, t_max, t_max_idx, t_avg, t_stdev, t_var) = series_stats(Trend)\n| project ServiceName, ResidualStdev=round(r_stdev, 2), ResidualMax=round(r_max, 2), TrendSlope=round(t_avg, 4)\n| order by ResidualStdev desc",
