              "type": "and"
            }
          },
          "pluginVersion": "6.0.1",
          "query": "let lookback = 24h;\nlet step = ${bin_size};\nlet total_bins = toint(lookback / step);\nOTELTraces\n| where StartTime > ago(lookback)\n| extend ServiceName = tostring(parse_json(ResourceAttributes)[\"service.name\"])\n| where ServiceName == \"${service}\"\n| make-series SpanCount=count() on StartTime from bin(ago(lookback), ${bin_size}) to bin(now(), step) - step step step\n| extend (fft_real, fft_imag) = series_fft(SpanCount)\n| project fft_real, fft_imag\n| mv-expand with_itemindex=i fft_real to typeof(double), fft_imag to typeof(double)\n| where i > 0 and i <= total_bins / 2\n| extend Magnitude = round(sqrt(fft_real * fft_real + fft_imag * fft_imag), 2)\n| extend PeriodMinutes = round(toreal(total_bins) / toreal(i) * 5.0, 1)\n| extend PeriodHuman = case(\n    PeriodMinutes >= 1440, strcat(round(PeriodMinutes / 1440, 1), \" days\"),\n    PeriodMinutes >= 60, strcat(round(PeriodMinutes / 60, 1), \" hours\"),\n    strcat(PeriodMinutes, \" min\"))\n| top 10 by Magnitude desc\n| project Rank=row_number(), PeriodHuman, PeriodMinutes, Magnitude",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "table"
        }
      ],
      "title": "Top Frequency Components in Span Volume - ${service}",
