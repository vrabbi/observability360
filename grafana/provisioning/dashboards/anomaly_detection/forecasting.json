          "pluginVersion": "6.0.1",
          "query": "let _steps = toint(${forecast_range}/${bin_size});\nlet _now = bin(now(), ${bin_size});\nOTELTraces\n| where StartTime >= bin(ago(24h), ${bin_size}) and StartTime < _now\n| extend ServiceName = tostring(parse_json(ResourceAttributes)[\"service.name\"])\n| where ServiceName == \"${service}\"\n| make-series SpanCount=count() on StartTime from bin(ago(24h), ${bin_size}) to _now + totimespan(${forecast_range}) step ${bin_size}\n| extend _hist_len = toint(array_length(SpanCount)) - _steps\n| extend _hist_arr = array_slice(SpanCount, 0, _hist_len - 1)\n| extend (Baseline, Seasonal, Trend, Residual) = series_decompose(_hist_arr)\n| extend (r_min, r_min_idx, r_max, r_max_idx, r_avg, r_stdev, r_var) = series_stats(Residual)\n| extend _pattern_len = min_of(_steps, _hist_len)\n| extend _pattern_start = _hist_len - _pattern_len\n| extend _idx = range(0, toint(array_length(SpanCount)) - 1, 1)\n| mv-expand StartTime to typeof(datetime), SpanCount to typeof(long), _idx to typeof(int)\n| extend _fc_offset = _idx - _hist_len\n| extend _src_idx = iff(_fc_offset >= 0, _pattern_start + (_fc_offset % _pattern_len), _idx)\n| extend _forecast_raw = todouble(_hist_arr[toint(_src_idx)])\n| project StartTime,\n    SpanCount = iff(_idx < _hist_len, tolong(SpanCount), long(null)),\n    Forecast = iff(_idx >= _hist_len - 1, round(_forecast_raw, 0), real(null)),\n    ForecastLow = iff(_idx >= _hist_len - 1, round(max_of(_forecast_raw - 2.5 * r_stdev, 0.0), 0), real(null)),\n    ForecastHigh = iff(_idx >= _hist_len - 1, round(_forecast_raw + 2.5 * r_stdev, 0), real(null))",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
