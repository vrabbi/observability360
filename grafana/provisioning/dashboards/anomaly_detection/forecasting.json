      "targets": [
        {
          "database": "openteldb",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "OBS360DataSource"
          },
          "query": "let _fr = ${forecast_range};\nlet _bs = ${bin_size};\nlet _steps = toint(_fr / _bs);\nlet _now = bin(now(), _bs);\nlet volume = OTELTraces\n| where StartTime between (bin(ago(24h), _bs) .. _now)\n| extend ServiceName = tostring(parse_json(ResourceAttributes)[\"service.name\"])\n| where ServiceName != \"\"\n| make-series SpanCount=count() on StartTime from bin(ago(24h), _bs) to _now + _fr step _bs by ServiceName\n| extend Forecast = series_decompose_forecast(SpanCount, _steps, toint(1h/_bs))\n| mv-expand StartTime to typeof(datetime), SpanCount to typeof(long), Forecast to typeof(double)\n| summarize\n    CurrentAvg = round(avgif(todouble(SpanCount), StartTime >= _now - _fr and StartTime < _now), 0),\n    ForecastAvg = round(avgif(Forecast, StartTime >= _now), 0)\n  by ServiceName\n| extend ThroughputChange = round((ForecastAvg - CurrentAvg) / CurrentAvg * 100.0, 1);\nlet latency = OTELTraces\n| where StartTime between (bin(ago(24h), _bs) .. _now)\n| extend ServiceName = tostring(parse_json(ResourceAttributes)[\"service.name\"])\n| where ServiceName != \"\"\n| extend DurationMs = datetime_diff(\"millisecond\", EndTime, StartTime)\n| make-series P99=percentile(DurationMs, 99) on StartTime from bin(ago(24h), _bs) to _now + _fr step _bs by ServiceName\n| extend Forecast = series_decompose_forecast(P99, _steps, toint(1h/_bs))\n| mv-expand StartTime to typeof(datetime), P99 to typeof(double), Forecast to typeof(double)\n| summarize\n    CurrentP99 = round(avgif(P99, StartTime >= _now - _fr and StartTime < _now), 1),\n    ForecastP99 = round(avgif(Forecast, StartTime >= _now), 1)\n  by ServiceName\n| extend LatencyChange = round((ForecastP99 - CurrentP99) / CurrentP99 * 100.0, 1);\nvolume\n| join kind=inner latency on ServiceName\n| where CurrentAvg > 5\n| project\n    Service=ServiceName,\n    [\"Throughput/bin\"]=CurrentAvg,\n    [\"Forecast Throughput\"]=ForecastAvg,\n    [\"Throughput Trend %\"]=ThroughputChange,\n    [\"P99 Latency (ms)\"]=CurrentP99,\n    [\"Forecast P99 (ms)\"]=ForecastP99,\n    [\"Latency Trend %\"]=LatencyChange\n| order by [\"Throughput/bin\"] desc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "table"
        }
      ],
