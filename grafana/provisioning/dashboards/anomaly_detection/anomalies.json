          },
          "query": "OTELTraces\n| where $__timeFilter(StartTime)\n| extend ServiceName = tostring(parse_json(ResourceAttributes)[\"service.name\"])\n| where ServiceName == \"${service}\"\n| extend DurationMs = datetime_diff(\"millisecond\", EndTime, StartTime)\n| make-series AvgLatency=avg(DurationMs) on StartTime from bin($__timeFrom, ${bin_size}) to $__timeTo step ${bin_size}\n| extend (anomalies, score, baseline) = series_decompose_anomalies(AvgLatency, 1.5)\n| mv-expand StartTime to typeof(datetime), AvgLatency to typeof(double), anomalies to typeof(int), score to typeof(double), baseline to typeof(double)\n| project StartTime, AvgLatencyMs=round(AvgLatency, 2), Baseline=round(baseline, 2), Anomaly=iff(anomalies != 0, round(AvgLatency, 2), real(null))",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "time_series"
