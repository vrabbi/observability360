            "type": "grafana-azure-data-explorer-datasource",
            "uid": "OBS360DataSource"
          },
          "query": "OTELTraces\n| where $__timeFilter(StartTime)\n| extend ServiceName = tostring(parse_json(ResourceAttributes)[\"service.name\"])\n| where ServiceName == \"${service}\"\n| make-series SpanCount=count() on StartTime from bin($__timeFrom, ${bin_size}) to $__timeTo step ${bin_size}\n| extend (anomalies, score, baseline) = series_decompose_anomalies(SpanCount, 1.5)\n| mv-expand StartTime to typeof(datetime), SpanCount to typeof(long), anomalies to typeof(int), score to typeof(double), baseline to typeof(double)\n| project StartTime, SpanCount, Baseline=tolong(baseline), Anomaly=iff(anomalies != 0, tolong(SpanCount), long(null))",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ],
