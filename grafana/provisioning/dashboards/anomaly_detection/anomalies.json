      "targets": [
        {
          "database": "openteldb",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "OBS360DataSource"
          },
          "query": "let SpanAnomalies = OTELTraces\n| where $__timeFilter(StartTime)\n| extend ServiceName = tostring(parse_json(ResourceAttributes)[\"service.name\"])\n| where ServiceName != \"\"\n| make-series SpanCount=count() on StartTime from bin($__timeFrom, ${bin_size}) to $__timeTo step ${bin_size} by ServiceName\n| extend (anomalies, score, baseline) = series_decompose_anomalies(SpanCount, 1.5)\n| mv-expand StartTime to typeof(datetime), SpanCount to typeof(long), anomalies to typeof(int), score to typeof(double), baseline to typeof(double)\n| where anomalies != 0\n| project Time=StartTime, ServiceName, Dimension=\"Span Volume\", ActualValue=tolong(SpanCount), ExpectedBaseline=tolong(baseline), AnomalyScore=round(score, 2), Direction=iff(anomalies > 0, \"Spike\", \"Drop\");\nlet ErrorAnomalies = OTELLogs\n| where $__timeFilter(Timestamp)\n| extend ServiceName = tostring(parse_json(ResourceAttributes)[\"service.name\"])\n| where ServiceName != \"\"\n| where tolower(SeverityText) in (\"error\", \"critical\")\n| make-series ErrorCount=count() on Timestamp from bin($__timeFrom, ${bin_size}) to $__timeTo step ${bin_size} by ServiceName\n| extend (anomalies, score, baseline) = series_decompose_anomalies(ErrorCount, 1.5)\n| mv-expand Timestamp to typeof(datetime), ErrorCount to typeof(long), anomalies to typeof(int), score to typeof(double), baseline to typeof(double)\n| where anomalies != 0\n| project Time=Timestamp, ServiceName, Dimension=\"Error Rate\", ActualValue=tolong(ErrorCount), ExpectedBaseline=tolong(baseline), AnomalyScore=round(score, 2), Direction=iff(anomalies > 0, \"Spike\", \"Drop\");\nSpanAnomalies\n| union ErrorAnomalies\n| sort by abs(AnomalyScore) desc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "table"
        }
      ],
      "title": "Anomaly Events Log (All Services)",
      "type": "table"
    }
