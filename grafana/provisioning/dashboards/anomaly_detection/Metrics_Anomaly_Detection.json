            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Variability"
          }
        ]
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "OpenAI": false,
          "database": "openteldb",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "OBS360DataSource"
          },
          "expression": {
            "groupBy": {
              "expressions": [],
              "type": "and"
            },
            "reduce": {
              "expressions": [],
              "type": "and"
            },
            "where": {
              "expressions": [],
              "type": "and"
            }
          },
          "pluginVersion": "6.0.1",
          "query": "OTELMetrics\r\n| where $__timeFilter(Timestamp)\r\n| extend service = tostring(parse_json(ResourceAttributes)[\"service.name\"])\r\n| where service == \"${service_name}\"\r\n| summarize avg_val = avg(MetricValue), stdev_val = stdev(MetricValue), min_val = min(MetricValue), max_val = max(MetricValue), sample_count = count() by MetricName\r\n| where sample_count > 10 and avg_val > 0\r\n| extend Variability = round(stdev_val / avg_val * 100, 1)\r\n| extend MaxMinRatio = round(max_val / (min_val + 0.0001), 2)\r\n| order by Variability desc\r\n| project MetricName, Variability, AvgValue = round(avg_val, 4), MinValue = round(min_val, 4), MaxValue = round(max_val, 4), MaxMinRatio, Samples = sample_count",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "table"
        }
      ],
      "title": "High Variability Metrics \u2014 order by Variability",
      "type": "table"
    },
