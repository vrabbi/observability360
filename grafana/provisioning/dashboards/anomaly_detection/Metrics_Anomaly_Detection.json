            },
            "reduce": {
              "expressions": [],
              "type": "and"
            },
            "where": {
              "expressions": [],
              "type": "and"
            }
          },
          "pluginVersion": "6.0.1",
          "query": "let top_metrics = OTELMetrics\r\n    | where $__timeFilter(Timestamp)\r\n    | extend service = tostring(parse_json(ResourceAttributes)[\"service.name\"])\r\n    | where service == \"${service_name}\"\r\n    | summarize bin_avg = avg(MetricValue) by bin(Timestamp, $__interval), MetricName\r\n    | summarize stdev_t = stdev(bin_avg), max_t = max(bin_avg), n = count() by MetricName\r\n    | where n > 3 and max_t > 0\r\n    | extend Spread = stdev_t / max_t\r\n    | top 10 by Spread desc\r\n    | project MetricName;\r\nlet max_vals = OTELMetrics\r\n    | where $__timeFilter(Timestamp)\r\n    | extend service = tostring(parse_json(ResourceAttributes)[\"service.name\"])\r\n    | where service == \"${service_name}\" and MetricName in (top_metrics)\r\n    | summarize max_val = max(MetricValue) by MetricName;\r\nOTELMetrics\r\n| where $__timeFilter(Timestamp)\r\n| extend service = tostring(parse_json(ResourceAttributes)[\"service.name\"])\r\n| where service == \"${service_name}\" and MetricName in (top_metrics)\r\n| summarize avg_value = avg(MetricValue) by bin(Timestamp, $__interval), MetricName\r\n| join kind=inner max_vals on MetricName\r\n| extend pct_of_max = round(avg_value * 100.0 / max_val, 1)\r\n| project Timestamp, MetricName, pct_of_max\r\n| order by Timestamp asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "time_series"
        },
        {
          "OpenAI": false,
          "database": "openteldb",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "OBS360DataSource"
          },
          "expression": {
            "groupBy": {
              "expressions": [],
              "type": "and"
            },
            "reduce": {
              "expressions": [],
              "type": "and"
            },
            "where": {
              "expressions": [],
              "type": "and"
            }
          },
          "pluginVersion": "6.0.1",
          "query": "let top_metrics = OTELMetrics\r\n    | where $__timeFilter(Timestamp)\r\n    | extend service = tostring(parse_json(ResourceAttributes)[\"service.name\"])\r\n    | where service == \"${service_name}\"\r\n    | summarize bin_avg = avg(MetricValue) by bin(Timestamp, $__interval), MetricName\r\n    | summarize stdev_t = stdev(bin_avg), max_t = max(bin_avg), n = count() by MetricName\r\n    | where n > 3 and max_t > 0\r\n    | extend Spread = stdev_t / max_t\r\n    | top 10 by Spread desc\r\n    | project MetricName;\r\nlet max_vals = OTELMetrics\r\n    | where $__timeFilter(Timestamp)\r\n    | extend service = tostring(parse_json(ResourceAttributes)[\"service.name\"])\r\n    | where service == \"${service_name}\" and MetricName in (top_metrics)\r\n    | summarize max_val = max(MetricValue) by MetricName;\r\nOTELMetrics\r\n| where $__timeFilter(Timestamp)\r\n| extend service = tostring(parse_json(ResourceAttributes)[\"service.name\"])\r\n| where service == \"${service_name}\" and MetricName in (top_metrics)\r\n| make-series avg_value = avg(MetricValue) default=0 on Timestamp step $__interval by MetricName\r\n| extend (anomalies, anomaly_score, baseline) = series_decompose_anomalies(avg_value, 1.5, -1, 'linefit')\r\n| mv-expand Timestamp to typeof(datetime), avg_value to typeof(double), anomalies to typeof(int)\r\n| where toint(anomalies) != 0\r\n| join kind=inner max_vals on MetricName\r\n| extend pct_of_max = round(todouble(avg_value) * 100.0 / max_val, 1)\r\n| project Timestamp, MetricName, pct_of_max\r\n| order by Timestamp asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "B",
          "resultFormat": "time_series"
        }
