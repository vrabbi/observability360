      "pluginVersion": "11.4.0",
      "targets": [
        {
          "OpenAI": false,
          "database": "openteldb",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "OBS360DataSource"
          },
          "expression": {
            "groupBy": {
              "expressions": [],
              "type": "and"
            },
            "reduce": {
              "expressions": [],
              "type": "and"
            },
            "where": {
              "expressions": [],
              "type": "and"
            }
          },
          "pluginVersion": "6.0.1",
          "query": "OTELMetrics\r\n| where $__timeFilter(Timestamp)\r\n| extend service = tostring(parse_json(ResourceAttributes)[\"service.name\"])\r\n| where service == \"${service_name}\"\r\n| summarize p50 = percentile(MetricValue, 50), p95 = percentile(MetricValue, 95), p99 = percentile(MetricValue, 99), sample_count = count() by MetricName\r\n| where sample_count > 5 and p50 > 0\r\n| extend SpikeRatio = round(p99 / p50, 2)\r\n| where SpikeRatio > 2\r\n| order by SpikeRatio desc\r\n| project MetricName, SpikeRatio, P50 = round(p50, 4), P95 = round(p95, 4), P99 = round(p99, 4), Samples = sample_count",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "table"
        }
      ],
      "title": "Percentile Outliers \u2014 order by SpikeRatio",
      "type": "table"
    },
