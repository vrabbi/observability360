        "noData": {
          "message": "No ingestion gaps detected for this service"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "OpenAI": false,
          "database": "openteldb",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "OBS360DataSource"
          },
          "expression": {
            "groupBy": {
              "expressions": [],
              "type": "and"
            },
            "reduce": {
              "expressions": [],
              "type": "and"
            },
            "where": {
              "expressions": [],
              "type": "and"
            }
          },
          "pluginVersion": "6.0.1",
          "query": "let top_gap_metrics = OTELMetrics\r\n    | where $__timeFilter(Timestamp)\r\n    | extend service = tostring(parse_json(ResourceAttributes)[\"service.name\"])\r\n    | where service == \"${service_name}\"\r\n    | summarize bin_count = count() by bin(Timestamp, $__interval), MetricName\r\n    | summarize actual_bins = count(), first_bin = min(Timestamp), last_bin = max(Timestamp), avg_count = avg(bin_count) by MetricName\r\n    | where actual_bins > 3 and avg_count > 5\r\n    | extend expected_bins = tolong((last_bin - first_bin) / $__interval) + 1\r\n    | extend missing_bins = expected_bins - actual_bins\r\n    | where missing_bins > 0\r\n    | top 10 by missing_bins desc\r\n    | project MetricName;\r\nOTELMetrics\r\n| where $__timeFilter(Timestamp)\r\n| extend service = tostring(parse_json(ResourceAttributes)[\"service.name\"])\r\n| where service == \"${service_name}\"\r\n| where MetricName in (top_gap_metrics)\r\n| make-series _count = count() default=0 on Timestamp step $__interval by MetricName\r\n| mv-expand _count to typeof(long), Timestamp to typeof(datetime)\r\n| summarize metric_count = toreal(max(_count)) by Timestamp, MetricName\r\n| extend metric_count = iff(metric_count == 0.0, real(null), metric_count)\r\n| order by Timestamp asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ],
      "title": "Top 10 Metrics \u2014 Ingestion Rate (Detect Gaps)",
      "type": "timeseries"
    }
